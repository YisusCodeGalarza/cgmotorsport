#: .\main_app\templates\main_app\calendario.html:45
#: .\main_app\templates\main_app\home.html:61
msgid "12 - 17 Septiembre 2023"
msgstr "September 12 - 17, 2023"

#: .\main_app\templates\main_app\calendario.html:46
#: .\main_app\templates\main_app\home.html:62
msgid "4th SCORE Baja 400"
msgstr "4th SCORE Baja 400"

#: .\main_app\templates\main_app\calendario.html:47
msgid ""
"El desafío perfecto de media distancia. 400 millas de terreno súper técnico "
"que pondrán a prueba la estrategia del equipo y prepararán el terreno para "
"la gran final."
msgstr ""
"The perfect mid-distance challenge. 400 miles of highly technical terrain "
"that will test the team's strategy and set the stage for the grand finale."

#: .\main_app\templates\main_app\calendario.html:62
msgid "13 - 18 Noviembre 2023"
msgstr "November 13 - 18, 2023"

#: .\main_app\templates\main_app\calendario.html:63
msgid "56th SCORE Baja 1000"
msgstr "56th SCORE Baja 1000"

#: .\main_app\templates\main_app\calendario.html:64
msgid ""
"La madre de todas las batallas off-road. Mil millas de polvo, oscuridad, "
"fatiga extrema y adrenalina pura cruzando toda la península. Aquí nacen las "
"verdaderas leyendas."
msgstr ""
"The mother of all off-road battles. A thousand miles of dust, darkness, "
"extreme fatigue, and pure adrenaline crossing the entire peninsula. This "
"is where true legends are born."

#: .\main_app\templates\main_app\calendario.html:66
msgid "Ensenada - La Paz, B.C.S."
msgstr "Ensenada - La Paz, B.C.S."

